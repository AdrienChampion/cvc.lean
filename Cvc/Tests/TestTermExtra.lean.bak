module

public import Cvc.Term
import Cvc.Ext

public import CvcTests.TestTerm



namespace Cvc.Tests


/-- info:
#[b2 → true, b3 → b2, b4 → b2, false → b1] (ite b1 (and b2 b3) (xor (xor b4 b2) false))
→ (ite b1 (and true b2) (xor (xor b2 true) b1))
-/
#testTerm
  let term ← smt! if b1 then b2 ∧ b3 else b4 ⊻ b2 ⊻ fls
  let terms := #[b2, b3, b4, fls]
  let repls := #[tru, b2, b2, b1]
  let term' ← term.substitute terms repls
  println! "{terms.zip repls |>.map fun (t, r) => s!"{t} → {r}"} {term}"
  println! "→ {term'}"
